<%- include('partials/header') %>
<div class="auth-box panel">
<h1><%= mode==='login'?'Welcome back':'Join the Vault' %></h1>
<% if(error){ %><p class="err"><%= error %></p><% } %>
<form action="/auth/<%= mode %>" method="POST">
<% if(mode==='register'){ %><input name="username" placeholder="username" required><% } %>
<input name="email" type="email" placeholder="email" required>
<input name="password" type="password" placeholder="password" required>
<button class="cta-btn big"><%= mode==='login'?'Login':'Create account' %></button>
</form>
<p class="tiny"><%= mode==='login'?`No account? <a href="/auth/register">Register</a>`:`Have one? <a href="/auth/login">Login</a>` %> · demo seed login: gamer@vault.gg / password123</p>
</div>
<%- include('partials/footer') %>

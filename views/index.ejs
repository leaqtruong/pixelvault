<%- include('partials/header') %>

<% if (featured.length) { const f = featured[0]; %>
<h2>Featured &amp; Recommended</h2>
<div class="spotlight">
  <a class="spotlight_main" href="/games/<%= f.slug %>"><img src="<%= f.coverImage %>"></a>
  <div class="spotlight_side">
    <h2><%= f.title %></h2>
    <div class="spot_thumbs">
      <% (f.screenshots||[]).concat([f.coverImage]).slice(0,4).forEach(s=>{ %><img src="<%= s %>" loading="lazy"><% }) %>
    </div>
    <p class="avail">Now Available</p>
    <p class="tiny"><%= (f.genres||[]).join(', ') %></p>
    <div style="margin-top:auto"><%- include('partials/price', { g: f }) %></div>
  </div>
</div>
<% } else { %>
<div class="section"><p class="muted">The catalog is empty. Run <code>npm run seed</code> to stock the store.</p></div>
<% } %>

<h2 class="row-title">Browse by Category <a href="/games">More</a></h2>
<div class="cat_tiles">
  <% (typeof catTiles !== 'undefined' && catTiles.length ? catTiles : []).forEach(t=>{ %>
    <a class="cat_tile" href="/games?genre=<%= encodeURIComponent(t.name) %>"><img src="<%= t.img %>" loading="lazy"><span><%= t.name %></span></a>
  <% }) %>
</div>

<h2 class="row-title">Special Offers <a href="/games?onSale=1">Browse More</a></h2>
<div class="card-row">
  <% deals.forEach(g=>{ %>
    <a class="gcard" href="/games/<%= g.slug %>"><img src="<%= g.coverImage %>" loading="lazy"><div class="gmeta"><b><%= g.title %></b><%- include('partials/price', { g }) %></div></a>
  <% }) %>
</div>
<% if(!deals.length){ %><p class="muted">No specials right now. Check back during the next fest.</p><% } %>

<h2 class="row-title">New &amp; Trending <a href="/games?sort=newest">Browse More</a></h2>
<div class="card-row">
  <% fresh.slice(0,4).forEach(g=>{ %>
    <a class="gcard" href="/games/<%= g.slug %>"><img src="<%= g.coverImage %>" loading="lazy"><div class="gmeta"><b><%= g.title %></b><span class="genres"><%= (g.genres||[]).slice(0,2).join(', ') %></span><%- include('partials/price', { g }) %></div></a>
  <% }) %>
</div>

<% if (typeof toys !== 'undefined' && toys.length) { %>
<h2 class="row-title">Toys &amp; Collectibles <a href="/toys">Shop All Merch</a></h2>
<div class="card-row">
  <% toys.forEach(t=>{ %>
    <a class="gcard toy" href="/toys/<%= t.slug %>"><img src="<%= t.coverImage %>" loading="lazy"><div class="gmeta"><b><%= t.title %></b><span class="genres"><%= t.brand || '' %></span><div class="price_row"><span class="plain_price">$<%= t.price.toFixed(2) %></span></div></div></a>
  <% }) %>
</div>
<% } %>

<div class="two-col">
  <div>
    <h2 class="row-title">Community Activity <a href="/community">Visit Forums</a></h2>
    <% threads.forEach(t=>{ %><a class="thread" href="/community/p/<%= t._id %>"><b><%= t.title %></b><span><%= t.author?.username %> · <%= t.replies?.length||0 %> replies</span></a><% }) %>
  </div>
  <div class="ship-box">
    <h3>Physical Editions</h3>
    <p class="tiny">Boxed copies ship from US-EAST / US-WEST with live tracking. Free standard shipping on orders over $75.</p>
    <ul><li>Standard (5-7 days)</li><li>Express (2 days) · Overnight</li><li>Tracking on every order</li></ul>
    <a class="ghost-btn" href="/games">Shop physical editions</a>
  </div>
</div>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<h1>Order #<%= String(order._id).slice(-6) %></h1>
<p class="tiny"><%= new Date(order.createdAt).toLocaleString() %> · status: <b><%= order.status %></b> · paid card ••<%= order.payment?.last4 %></p>
<div class="two-col"><div class="panel"><h3>Items</h3>
<% order.items.forEach(i=>{ %><p><%= i.qty %>× <%= i.title %> (<%= i.edition %>) — $<%= (i.unitPrice*i.qty).toFixed(2) %></p>
<% if (i.keyIds && i.keyIds.length) { %><div class="panel" style="margin:6px 0"><b class="tiny">Delivered keys:</b><% i.keyIds.forEach(k=>{ const id = String(k._id || k); const plain = (typeof plainById !== 'undefined' && plainById[id]) || k.codeEnc || ''; %><br><code><%= plain %></code><span class="tiny"> · <%= k.platform || 'Steam' %></span><% }) %><br><span class="tiny">Demo placeholder keys — redeem on Steam client. Also in <a href="/library">library</a>.</span></div><% } %>
<% }) %>
<hr><p>Subtotal $<%= order.subtotal.toFixed(2) %> · Tax $<%= order.tax.toFixed(2) %> · Ship $<%= order.shippingTotal.toFixed(2) %></p><h3>Total $<%= order.grandTotal.toFixed(2) %></h3></div>
<div class="panel"><h3>Shipment</h3>
<% if(order.shipment){ %><p>Tracking: <code><%= order.shipment.tracking %></code></p><p>Carrier: <%= order.shipment.carrier %> · <%= order.shipment.method %></p>
<div class="track"><% ['packing','shipped','in_transit','out_for_delivery','delivered'].forEach(s=>{ %><span class="<%= s===order.shipment.status?'on':'' %>"><%= s.replace(/_/g,' ') %></span><% }) %></div>
<p class="tiny"><%= order.shipment.address.fullName %>, <%= order.shipment.address.street %>, <%= order.shipment.address.city %> <%= order.shipment.address.postal %>, <%= order.shipment.address.country %></p>
<form action="/orders/<%= order._id %>/advance" method="POST"><button class="ghost-btn">Simulate carrier scan →</button></form>
<% } else { %><p>Digital order — keys added straight to your <a href="/library">library</a>. No shipping needed.</p><% } %></div></div>
<%- include('partials/footer') %>

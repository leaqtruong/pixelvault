<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PixelVault — <%= typeof title !== 'undefined' ? title + ' | ' : '' %>Welcome</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="topbar_inner">
    <a class="logo" href="/">PIXEL<span>VAULT</span></a>
    <nav>
      <a href="/games">Store</a>
      <a href="/community">Community</a>
      <a href="/mods">Mods</a>
      <a href="/dev">Dev Portal</a>
    </nav>
    <div class="top-actions">
      <a class="icon-btn" href="/cart">Cart</a>
      <% if (sessionUser) { %>
        <a class="pill" href="/users/<%= sessionUser.username %>"><%= sessionUser.username %></a>
        <form action="/auth/logout" method="POST" style="display:inline"><button class="ghost-btn sm">Logout</button></form>
      <% } else { %>
        <a class="ghost-btn sm" href="/auth/login">login</a>
        <a class="install-btn" href="/auth/register">Join free</a>
      <% } %>
    </div>
  </div>
</header>
<div class="store_nav"><div class="store_nav_inner">
  <div class="drop"><button>Your Store</button><div class="drop_menu">
    <a href="/">Home</a><a href="/library/recommendations">Recommendations</a><a href="/library">Your Library</a><a href="/games?sort=newest">Recently Released</a>
  </div></div>
  <div class="drop"><button>New &amp; Noteworthy</button><div class="drop_menu">
    <a href="/games?sort=popular">Top Sellers</a><a href="/games?sort=newest">New &amp; Trending</a><a href="/games?sort=rating">Most Played</a><a href="/games?onSale=1">Special Offers</a>
  </div></div>
  <div class="drop"><button>Categories</button><div class="drop_menu">
    <a href="/games?genre=Action">Action</a><a href="/games?genre=Adventure">Adventure</a><a href="/games?genre=RPG">RPG</a><a href="/games?genre=Strategy">Strategy</a><a href="/games?genre=Simulation">Simulation</a><a href="/games?genre=Sports">Sports</a><a href="/games?genre=Racing">Racing</a><a href="/games?genre=Casual">Casual</a><a href="/games?genre=Indie">Indie</a><a href="/games?genre=Horror">Horror</a><a href="/games?genre=Puzzle">Puzzle</a><a href="/games?genre=Shooter">Shooter</a><a href="/games?genre=Survival">Survival</a><a href="/games?genre=Free%20to%20Play">Free to Play</a><a href="/games?moddable=1">Moddable</a>
  </div></div>
  <div class="drop"><button>Platforms</button><div class="drop_menu">
    <a href="/games?platform=Windows">Windows</a><a href="/games?platform=Mac">Mac</a><a href="/games?platform=Linux">Linux</a><a href="/games?platform=Steam%20Deck">Steam Deck</a><a href="/games?platform=VR">VR</a>
  </div></div>
  <div class="drop"><button>Specials</button><div class="drop_menu">
    <a href="/games?sort=popular">Top Sellers</a><a href="/games?sort=newest">New &amp; Trending</a><a href="/games?onSale=1">Special Offers</a><a href="/games?maxPrice=0">Free to Play</a>
  </div></div>
  <div class="drop"><button>Toys &amp; Merch</button><div class="drop_menu">
    <a href="/toys">All Collectibles</a><a href="/toys?category=Plush">Plushies</a><a href="/toys?category=Figure">Figures &amp; Statues</a><a href="/toys?category=Pins">Pins</a>
  </div></div>
  <a href="/community">Forums</a>
  <a href="/mods">Workshop</a>
  <form class="store_search" action="/games" method="GET"><input name="q" placeholder="search" value="<%= typeof query !== 'undefined' ? (query.q||'') : '' %>"><button>Go</button></form>
</div></div>
<main class="wrap">

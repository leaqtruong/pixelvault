<%- include('partials/header') %>
<h1>Toys &amp; Collectibles</h1>
<p class="muted">Official merch tied to games in the catalog — plushies, figures, statues, pins. Ships physical with tracking.</p>
<div class="store_layout">
  <aside>
    <div class="side_box"><h4>Category</h4>
      <a href="/toys">All</a>
      <% categories.forEach(c=>{ %><a href="/toys?category=<%= encodeURIComponent(c) %>"><%= c %></a><% }) %>
    </div>
    <div class="side_box"><h4>Brand</h4>
      <% brands.slice(0,10).forEach(b=>{ %><a href="/toys?brand=<%= encodeURIComponent(b) %>"><%= b.split(' (')[0] %></a><% }) %>
    </div>
    <div class="side_box"><h4>Price</h4>
      <a href="/toys?sort=priceAsc">Low to high</a>
      <a href="/toys?sort=priceDesc">High to low</a>
    </div>
  </aside>
  <div>
    <form class="filters" method="GET" action="/toys">
      <input name="q" placeholder="search collectibles" value="<%= query.q||'' %>">
      <select name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c %>" <%= query.category===c?'selected':'' %>><%= c %></option><% }) %></select>
      <select name="sort"><option value="popular" <%= query.sort==='popular'?'selected':'' %>>Most popular</option><option value="newest" <%= query.sort==='newest'?'selected':'' %>>Newest</option><option value="priceAsc" <%= query.sort==='priceAsc'?'selected':'' %>>Price: low to high</option><option value="priceDesc" <%= query.sort==='priceDesc'?'selected':'' %>>Price: high to low</option></select>
      <button class="ghost-btn sm">Apply</button>
    </form>
    <p class="tiny"><%= total %> results</p>
    <div class="card-grid">
    <% toys.forEach(t=>{ %>
      <a class="gcard toy" href="/toys/<%= t.slug %>">
        <img src="<%= t.coverImage %>" loading="lazy">
        <div class="gmeta"><b><%= t.title %></b>
          <span class="tiny" style="color:var(--amber)">★ <%= t.category %> · <%= t.brand %></span>
          <span class="tiny"><%= (t.stock||0) > 0 ? 'In stock (' + t.stock + ')' : 'Sold out' %></span>
          <div class="price_row"><span class="plain_price">$<%= t.price.toFixed(2) %></span></div>
        </div>
      </a>
    <% }) %>
    </div>
    <% if(!toys.length){ %><div class="section"><p class="muted">No collectibles match those filters. <a href="/toys">Clear search</a></p></div><% } %>
    <%- include('partials/pager', { total, totalPages, page, query }) %>
  </div>
</div>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<h1>Cart</h1>
<% if(!items.length){ %><p class="muted">Empty. <a href="/games">Go loot the store →</a></p><% } %>
<% items.forEach(i=>{ %>
<div class="cart-row"><img src="<%= i.coverImage %>"><div><b><%= i.title %></b><span class="tiny"><%= (i.kind||'game')==='toy' ? 'collectible' : i.edition %> · $<%= i.unitPrice.toFixed(2) %> each</span></div>
<form action="/cart/qty" method="POST"><input type="hidden" name="key" value="<%= i.key %>"><input type="number" name="qty" value="<%= i.qty %>" min="1" max="9"><button class="ghost-btn sm">Update</button></form>
<b>$<%= (i.unitPrice*i.qty).toFixed(2) %></b>
<form action="/cart/remove" method="POST"><input type="hidden" name="key" value="<%= i.key %>"><button class="ghost-btn sm">x</button></form></div>
<% }) %>
<% if(items.length){ %><div class="panel right"><h3>Subtotal: $<%= subtotal.toFixed(2) %></h3><p class="tiny">Tax + shipping calculated at checkout. Free standard shipping over $75.</p><a class="cta-btn big" href="/checkout">Checkout →</a></div><% } %>
<%- include('partials/footer') %>

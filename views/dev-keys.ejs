<%- include('partials/header') %>
<h1>Key vault — <%= game.title %></h1>
<p class="tiny"><a href="/dev">← Dev console</a> · <a href="/games/<%= game.slug %>">Store page</a></p>
<% if (typeof error !== 'undefined' && error) { %><p class="err"><%= error %></p><% } %>
<% if (typeof ok !== 'undefined' && ok) { %><p style="color:var(--accent)">OK: <%= ok %></p><% } %>
<div class="kpi-row">
<div class="kpi"><span>Available</span><b><%= available %></b></div>
<div class="kpi"><span>Sold</span><b><%= sold %></b></div>
<div class="kpi"><span>Revoked</span><b><%= revoked %></b></div>
</div>
<div class="two-col">
<div class="panel"><h3>Bulk import (CSV / one per line)</h3>
<p class="tiny">Paste third-party demo keys here for coursework only. Stored AES-256-GCM encrypted, never plaintext.</p>
<form action="/dev/<%= game._id %>/keys/import" method="POST">
<div class="row"><input name="batchId" placeholder="batch id (e.g. demo-batch-1)"><select name="platform"><option>Steam</option><option>Epic</option><option>GOG</option><option>PixelVault</option></select></div>
<textarea name="keys" placeholder="DEMO-XXXXX-XXXXX-XXXXX&#10;one per line" style="min-height:120px"></textarea>
<button class="cta-btn sm" style="margin-top:8px">Import keys</button>
</form></div>
<div class="panel"><h3>Generate demo placeholders</h3>
<p class="tiny">Creates fake <code>DEMO-XXXXX-XXXXX-XXXXX</code> keys for testing. Not real Steam keys.</p>
<form action="/dev/<%= game._id %>/keys/generate" method="POST">
<div class="row"><input name="count" type="number" min="1" max="500" value="20"><button class="ghost-btn sm">Generate</button></div>
</form>
<h3>Recent keys (hash only)</h3>
<table class="tbl"><tr><th>Hash</th><th>Status</th><th>Batch</th></tr>
<% recent.forEach(k=>{ %><tr><td class="tiny"><%= String(k.codeHash).slice(0,12) %>…</td><td><%= k.status %></td><td class="tiny"><%= k.batchId %></td></tr><% }) %>
</table></div>
</div>
<%- include('partials/footer') %>

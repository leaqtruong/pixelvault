<%- include('partials/header') %>
<h1><%= game && game._id ? 'Edit game' : 'Publish a game' %></h1>
<% if(error){ %><p class="err"><%= error %></p><% } %>
<form class="panel form-grid" action="<%= game && game._id ? `/dev/${game._id}/edit` : '/dev/new' %>" method="POST">
<input name="title" placeholder="Title *" value="<%= game?.title||'' %>" required>
<input name="tagline" placeholder="Tagline" value="<%= game?.tagline||'' %>">
<textarea name="description" placeholder="Full description"><%= game?.description||'' %></textarea>
<div class="row"><input name="studioName" placeholder="Studio" value="<%= game?.studioName||'' %>"><input name="coverImage" placeholder="Cover image URL" value="<%= game?.coverImage||'' %>" style="flex:2"></div>
<div class="row"><input name="price" type="number" step="0.01" placeholder="Digital price *" value="<%= game?.price??'' %>" required><input name="discountPct" type="number" placeholder="% off" value="<%= game?.discountPct||0 %>"><input name="genres" placeholder="Genres Steam: Action, RPG, Indie..." value="<%= (game?.genres||[]).join?.(', ')||game?.genres||'' %>"><input name="tags" placeholder="tags: Singleplayer, Co-op..." value="<%= (game?.tags||[]).join?.(', ')||'' %>"></div>
<div class="row"><input name="platforms" placeholder="Platforms: Windows, Mac, Linux, Steam Deck, VR" value="<%= (game?.platforms||[]).join?.(', ')||'' %>"><input name="features" placeholder="Features: Single-player, Steam Cloud..." value="<%= (game?.features||[]).join?.(', ')||'' %>"></div>
<textarea name="screenshots" placeholder="Screenshot URLs, one per line"><%= (game?.screenshots||[]).join?.('\n')||'' %></textarea>
<div class="row"><input name="version" placeholder="1.0.0" value="<%= game?.version||'1.0.0' %>"><input name="fileSizeGB" type="number" step="0.1" placeholder="GB" value="<%= game?.fileSizeGB||5 %>"><input name="rating" placeholder="E/E10+/T/M" value="<%= game?.rating||'E' %>"><input name="releaseDate" type="date" value="<%= game?.releaseDate?String(game.releaseDate).slice(0,10):'' %>"></div>
<h3>Physical edition</h3>
<div class="row"><label><input type="checkbox" name="physicalEnabled" <%= game?.physical?.enabled?'checked':'' %>> Enable box</label><input name="physicalPrice" type="number" step="0.01" placeholder="Box price" value="<%= game?.physical?.price||'' %>"><input name="physicalStock" type="number" placeholder="Stock" value="<%= game?.physical?.stock||50 %>"><input name="weightLb" type="number" step="0.1" placeholder="lb" value="<%= game?.physical?.weightLb||0.6 %>"></div>
<input name="physicalIncludes" placeholder="Box includes (comma)" value="<%= (game?.physical?.includes||[]).join?.(', ')||'' %>">
<h3>System requirements</h3>
<div class="row"><input name="os" placeholder="OS" value="<%= game?.systemReq?.os||'Windows 10 64-bit' %>"><input name="cpu" placeholder="CPU" value="<%= game?.systemReq?.cpu||'' %>"><input name="ram" placeholder="RAM" value="<%= game?.systemReq?.ram||'' %>"><input name="gpu" placeholder="GPU" value="<%= game?.systemReq?.gpu||'' %>"><input name="storage" placeholder="Storage" value="<%= game?.systemReq?.storage||'' %>"></div>
<button class="cta-btn big">Save game</button>
</form>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<div class="auth-box panel"><h1>Upload a mod</h1>
<% if(error){ %><p class="err"><%= error %></p><% } %>
<form action="/mods/new" method="POST">
<select name="game" required><% games.forEach(g=>{ %><option value="<%= g._id %>"><%= g.title %></option><% }) %></select>
<input name="title" placeholder="Mod title *" required><input name="tagline" placeholder="One-liner">
<textarea name="description" placeholder="What does it change? Install steps?"></textarea>
<div class="row"><input name="version" placeholder="1.0.0"><input name="gameVersion" placeholder="Game version"><select name="loader"><option value="vaultmod">vaultmod</option><option value="standalone">standalone</option><option value="lua">lua</option><option value="other">other</option></select></div>
<input name="downloadUrl" placeholder="https://…/mymod.zip *" required><input name="tags" placeholder="tags, comma">
<button class="cta-btn big">Publish mod</button></form></div>
<%- include('partials/footer') %>

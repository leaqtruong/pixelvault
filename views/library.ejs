<%- include('partials/header') %>
<h1><%= user.username %>'s library</h1>
<p class="muted"><%= user.library.length %> games · <%= Math.floor(totalMinutes/60) %>h <%= totalMinutes%60 %>m played · <a href="/library/recommendations">For you →</a></p>
<p class="tiny">Digital keys are delivered instantly after checkout — find them below and in <a href="/orders">order history</a>. Demo keys look like <code>DEMO-XXXXX-XXXXX-XXXXX</code> (placeholder, not real Steam keys).</p>
<div class="card-grid">
<% user.library.forEach(e=>{ if(!e.game) return; const gid = String(e.game._id || e.game); const myKeys = (typeof keysByGame !== 'undefined' && keysByGame[gid]) || []; %>
<div class="gcard<%= e.game.productType==='toy' ? ' toy' : '' %>"><img src="<%= e.game.coverImage %>"><div class="gmeta"><b><%= e.game.title %></b>
<span class="tiny"><%= e.edition %> · <%= Math.floor((e.playMinutes||0)/60) %>h <%= (e.playMinutes||0)%60 %>m · last <%= e.lastPlayedAt?new Date(e.lastPlayedAt).toLocaleDateString():'never' %></span>
<span class="tiny">Achievements: <%= (e.achievements||[]).map(a=>a.key).join(', ')||'no achievements yet' %></span>
<% if (myKeys.length) { %><div class="panel" style="margin:6px 0;padding:6px"><b class="tiny">Your keys (<%= myKeys.length %>):</b><% myKeys.forEach(k=>{ %><br><code class="tiny"><%= (typeof plainById !== 'undefined' && plainById[String(k._id)]) || '…' %></code><span class="tiny"> · <%= k.platform %> · <%= k.region %></span><% }) %></div><% } %>
<form action="/library/play/<%= e.game._id %>" method="POST"><button class="cta-btn sm">Play +30min</button></form>
<a class="ghost-btn sm" href="/games/<%= e.game.slug %>">Store page</a></div></div>
<% }) %>
</div>
<% if(!user.library.length){ %><p class="muted">Empty shelves. <a href="/games">Go buy something →</a></p><% } %>
<h2>My Collectibles (<%= (user.toyLibrary||[]).length %>)</h2>
<div class="card-row"><% (user.toyLibrary||[]).forEach(e=>{ if(!e.toy) return; %><a class="gcard sm toy" href="/toys/<%= e.toy.slug %>"><img src="<%= e.toy.coverImage %>"><div class="gmeta"><b><%= e.toy.title %></b><span class="tiny">×<%= e.qty %></span></div></a><% }) %></div>
<% if(!(user.toyLibrary||[]).length){ %><p class="muted">No collectibles yet. <a href="/toys">Browse the toy shelf →</a></p><% } %>
<h2>Wishlist (<%= user.wishlist.length %>)</h2>
<div class="card-row"><% user.wishlist.forEach(g=>{ if(!g) return; %><a class="gcard sm" href="/games/<%= g.slug %>"><img src="<%= g.coverImage %>"><div class="gmeta"><b><%= g.title %></b><span class="price"><b>$<%= (g.price*(1-(g.discountPct||0)/100)).toFixed(2) %></b></span></div></a><% }) %></div>
<h2>Toy Wishlist (<%= (user.toyWishlist||[]).length %>)</h2>
<div class="card-row"><% (user.toyWishlist||[]).forEach(t=>{ if(!t) return; %><a class="gcard sm toy" href="/toys/<%= t.slug %>"><img src="<%= t.coverImage %>"><div class="gmeta"><b><%= t.title %></b><span class="price"><b>$<%= t.price.toFixed(2) %></b></span></div></a><% }) %></div>
<%- include('partials/footer') %>

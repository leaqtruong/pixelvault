MONGO_URI=mongodb://127.0.0.1:27017/pixelvault
SESSION_SECRET=change-me-pixelvault-super-secret
KEY_ENCRYPTION_SECRET=change-me-32chars-minimum-for-AES-256-demo-only
PORT=3000
DEV_REVENUE_CUT=0.7
TAX_RATE=0.08
# Store prices are in USD. VNPay quotes VND, so the gateway amount is this rate
# multiplied by the order total. Set it to the rate your merchant settles at;
# it is the only place a currency conversion happens.
VND_PER_USD=25000
# Optional: Google login. Create an OAuth client at console.cloud.google.com
# (APIs & Services > Credentials), add http://localhost:3000 as an authorized
# JavaScript origin, then paste the Client ID here.
GOOGLE_CLIENT_ID=

# Optional: VNPay. Leave these empty and the store uses its built-in sandbox,
# which signs with a random per-boot key and moves no money. Set all three to
# switch the gateway to the real VNPay host. The secret never has a fallback:
# if it is missing while the other two are set, signatures would be computable
# by anyone who has read this repository.
# Values come from the merchant onboarding email; never commit the real ones.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=

# Pins the sandbox signing key so payments still verify across a restart.
# Leave empty and one is generated at every boot.
SANDBOX_HASH_SECRET=

# Optional: real key supplier. When KEY_SUPPLIER_URL is set, each paid order
# POSTs { game, edition, orderId } to it and expects { key } back. Leave empty
# and the store issues clearly-labelled DEMO placeholders instead.
# Real suppliers are B2B wholesale APIs (CodesWholesale, Xsolla,
# GameKeyDistribution, ...) — you sign up for your own account and point the
# store at their API (or a thin proxy that maps your catalog to their product
# ids). Never commit real credentials; set them in .env only.
KEY_SUPPLIER_URL=
# Optional bearer token if the supplier uses Authorization: Bearer <token>.
KEY_SUPPLIER_TOKEN=
# JSON field that holds the key in the supplier response (default: key).
KEY_SUPPLIER_KEY_FIELD=key

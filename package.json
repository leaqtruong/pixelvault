{
  "name": "pixelvault-game-store",
  "version": "1.0.0",
  "description": "PixelVault — game store with digital key vault + toy collectibles. React SPA + Node.js + Express + MongoDB.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed/seed.js",
